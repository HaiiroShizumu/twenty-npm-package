{
  "name": "@haiiro/interface",
  "version": "0.1.0",
  "description": "NorDiv skin for Twenty CRM: wallpaper, glass panels and accent with readability-checked presets",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/standalone/index.ts"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles/*": "./styles/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "nordiv-skin": "bin/nordiv-skin.mjs"
  },
  "files": [
    "bin",
    "dist",
    "styles",
    "assets",
    "README.md"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles/*": "./styles/*",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "jest --config jest.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "stage-publish": "node scripts/stage-publish.mjs"
  },
  "devDependencies": {
    "@swc/core": "^1.15.11",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "esbuild": "^0.28.1",
    "jest": "29.7.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
