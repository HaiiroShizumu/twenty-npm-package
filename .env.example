# Токен npm с правом публикации в @haiiro (scripts/publish.mjs)
NPM_TOKEN=

# CRM, куда ставятся приложения (scripts/reinstall.mjs)
CRM_URL=http://localhost:2020
# Ключ API этой CRM: «Настройки → API и вебхуки → Создать ключ»
CRM_API_KEY=

# Куда ставить скин @haiiro/interface: docker-контейнер Twenty...
TWENTY_CONTAINER=twenty-app-dev
# ...или папка собранного фронта Twenty на этой машине (тогда контейнер не нужен)
TWENTY_FRONT_DIR=
